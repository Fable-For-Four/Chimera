# Next.js (package-lock.json is committed on purpose)
web/node_modules/
web/.next/
web/next-env.d.ts
web/*.tsbuildinfo

# Logs and OS junk
*.log
.DS_Store
Thumbs.db

# Personal Claude settings (shared ones in .claude/ stay tracked)
.claude/settings.local.json
